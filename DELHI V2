/*
  TECHNOXIAN HIGH-SPEED LINE FOLLOWER + SUCTION
  Arduino Nano | 8-channel analog IR | DRV8833

  Sensors: A7, A6, A5, A4, A3, A2, A1, A0
  Black = HIGH reading
  White = LOW reading

  Calibration:
  1. White background: stationary for 3 seconds.
  2. Black line: manually sweep all sensors across it for 8 seconds.
  3. Each sensor gets its own threshold.

  Suction: 5% -> 7% -> 10% maximum.
*/

// ---------------- MOTOR PINS ----------------

#define IN1 10
#define IN2 9
#define IN3 6
#define IN4 5

// ---------------- SUCTION ----------------

#define SUCTION_PIN 11

// ---------------- SENSOR PINS ----------------

const byte sensorPins[8] = {
  A7, A6, A5, A4, A3, A2, A1, A0
};

const int weights[8] = {
  -35, -20, -10, -5, 5, 10, 20, 35
};

// ---------------- STEERING ----------------

const bool INVERT_STEERING = false;

int fastSpeed = 230;
int baseSpeed = 165;
int maxSpeed = 255;
int turnSpeed = 170;

float Kp = 1.10;
float Kd = 4.50;

float lastError = 0;
float filteredDerivative = 0;
int lastDirection = 1;

// ---------------- CALIBRATION ----------------

int whiteValue[8];
int blackValue[8];
int threshold[8];
int hysteresis[8];

bool sensorBlack[8];

unsigned long whiteSum[8];
unsigned int whiteCount[8];

// Keep the 12 strongest readings for each sensor.
const byte TOP_SAMPLES = 12;
int topBlack[8][TOP_SAMPLES];
byte topCount[8];

// =================================================
// MOTOR CONTROL
// =================================================

void setMotors(int left, int right) {

  left = constrain(left, -maxSpeed, maxSpeed);
  right = constrain(right, -maxSpeed, maxSpeed);

  if (left >= 0) {
    analogWrite(IN1, left);
    analogWrite(IN2, 0);
  } else {
    analogWrite(IN1, 0);
    analogWrite(IN2, -left);
  }

  if (right >= 0) {
    analogWrite(IN3, right);
    analogWrite(IN4, 0);
  } else {
    analogWrite(IN3, 0);
    analogWrite(IN4, -right);
  }
}

void stopMotors() {
  analogWrite(IN1, 0);
  analogWrite(IN2, 0);
  analogWrite(IN3, 0);
  analogWrite(IN4, 0);
}

void tankTurn(int direction) {
  setMotors(direction * turnSpeed,
            -direction * turnSpeed);
}

// =================================================
// SUCTION CONTROL - D11 / TIMER 2
// =================================================

void setupSuction() {

  pinMode(SUCTION_PIN, OUTPUT);

  TCCR2A = 0;
  TCCR2B = 0;

  TCCR2A |= (1 << COM2A1);
  TCCR2A |= (1 << WGM20);
  TCCR2B |= (1 << CS20);

  OCR2A = 0;
}

void setSuctionPercent(byte percent) {

  percent = constrain(percent, 0, 10);

  OCR2A = (byte)((percent * 255UL) / 100UL);
}

void startSuction() {

  setSuctionPercent(5);
  delay(300);

  setSuctionPercent(7);
  delay(300);

  setSuctionPercent(10);
}

// =================================================
// SENSOR READING
// =================================================

void readSensors(int values[8]) {

  for (byte i = 0; i < 8; i++) {
    values[i] = analogRead(sensorPins[i]);
  }
}

// =================================================
// LED SIGNAL
// =================================================

void flashLED(byte times, int onTime, int offTime) {

  for (byte i = 0; i < times; i++) {

    digitalWrite(LED_BUILTIN, HIGH);
    delay(onTime);

    digitalWrite(LED_BUILTIN, LOW);
    delay(offTime);
  }
}

// =================================================
// WHITE CALIBRATION
// =================================================

void calibrateWhite() {

  for (byte i = 0; i < 8; i++) {
    whiteSum[i] = 0;
    whiteCount[i] = 0;
  }

  digitalWrite(LED_BUILTIN, HIGH);

  unsigned long start = millis();

  while (millis() - start < 3000) {

    int values[8];
    readSensors(values);

    for (byte i = 0; i < 8; i++) {
      whiteSum[i] += values[i];
      whiteCount[i]++;
    }

    delay(2);
  }

  digitalWrite(LED_BUILTIN, LOW);

  for (byte i = 0; i < 8; i++) {

    whiteValue[i] =
      whiteCount[i] ?
      whiteSum[i] / whiteCount[i] : 1023;
  }
}

// =================================================
// SAVE STRONGEST BLACK READINGS
// =================================================

void saveBlackSample(byte sensor, int value) {

  for (byte j = 0; j < TOP_SAMPLES; j++) {

    if (value > topBlack[sensor][j]) {

      for (int k = TOP_SAMPLES - 1; k > j; k--) {
        topBlack[sensor][k] =
          topBlack[sensor][k - 1];
      }

      topBlack[sensor][j] = value;

      if (topCount[sensor] < TOP_SAMPLES) {
        topCount[sensor]++;
      }

      return;
    }
  }
}

// =================================================
// BLACK CALIBRATION
// =================================================

void calibrateBlack() {

  for (byte i = 0; i < 8; i++) {

    topCount[i] = 0;

    for (byte j = 0; j < TOP_SAMPLES; j++) {
      topBlack[i][j] = 0;
    }
  }

  unsigned long start = millis();

  while (millis() - start < 8000) {

    int values[8];
    readSensors(values);

    for (byte i = 0; i < 8; i++) {
      saveBlackSample(i, values[i]);
    }

    digitalWrite(LED_BUILTIN,
                 (millis() / 100) % 2);

    delay(2);
  }

  digitalWrite(LED_BUILTIN, LOW);
}

// =================================================
// CALCULATE INDIVIDUAL THRESHOLDS
// =================================================

bool calculateThresholds() {

  bool valid = true;

  for (byte i = 0; i < 8; i++) {

    if (topCount[i] < TOP_SAMPLES) {
      valid = false;
      continue;
    }

    unsigned long sum = 0;

    for (byte j = 0; j < TOP_SAMPLES; j++) {
      sum += topBlack[i][j];
    }

    blackValue[i] = sum / TOP_SAMPLES;

    int contrast =
      blackValue[i] - whiteValue[i];

    if (contrast < 120) {
      valid = false;
      continue;
    }

    threshold[i] =
      whiteValue[i] + (contrast * 45L) / 100L;

    hysteresis[i] = contrast / 25;

    hysteresis[i] =
      constrain(hysteresis[i], 8, 25);

    sensorBlack[i] = false;
  }

  return valid;
}

// =================================================
// COMPLETE CALIBRATION
// =================================================

void calibrateSensors() {

  stopMotors();

  while (true) {

    calibrateWhite();

    flashLED(3, 100, 100);

    calibrateBlack();

    if (calculateThresholds()) {

      flashLED(3, 400, 200);

      return;
    }

    flashLED(5, 80, 80);

    delay(500);
  }
}

// =================================================
// CLASSIFY SENSORS WITH HYSTERESIS
// =================================================

void classifySensors(int values[8]) {

  for (byte i = 0; i < 8; i++) {

    if (sensorBlack[i]) {

      if (values[i] <
          threshold[i] - hysteresis[i]) {
        sensorBlack[i] = false;
      }

    } else {

      if (values[i] >
          threshold[i] + hysteresis[i]) {
        sensorBlack[i] = true;
      }
    }
  }
}

// =================================================
// WAIT FOR ROBOT PLACEMENT
// =================================================

void waitForPlacement() {

  while (true) {

    int values[8];

    readSensors(values);
    classifySensors(values);

    if (sensorBlack[3] || sensorBlack[4]) {

      delay(100);

      readSensors(values);
      classifySensors(values);

      if (sensorBlack[3] || sensorBlack[4]) {
        break;
      }
    }

    digitalWrite(LED_BUILTIN,
                 (millis() / 400) % 2);
  }

  digitalWrite(LED_BUILTIN, HIGH);
  delay(500);
  digitalWrite(LED_BUILTIN, LOW);
}

// =================================================
// LINE RECOVERY
// =================================================

void recoverLine() {

  tankTurn(lastDirection);

  while (true) {

    int values[8];

    readSensors(values);
    classifySensors(values);

    int activeCount = 0;

    for (byte i = 0; i < 8; i++) {
      if (sensorBlack[i]) {
        activeCount++;
      }
    }

    if (activeCount > 0) {
      lastError = 0;
      return;
    }

    tankTurn(lastDirection);
  }
}

// =================================================
// IMPROVED HIGH-SPEED PD LINE FOLLOWING
// =================================================

void followLine() {

  int values[8];

  readSensors(values);
  classifySensors(values);

  long weightedSum = 0;
  int activeCount = 0;

  for (byte i = 0; i < 8; i++) {

    if (sensorBlack[i]) {
      weightedSum += weights[i];
      activeCount++;
    }
  }

  if (activeCount == 0) {
    filteredDerivative = 0;
    recoverLine();
    return;
  }

  float error =
    (float)weightedSum / activeCount;

  if (error < -2) {
    lastDirection = -1;
  }
  else if (error > 2) {
    lastDirection = 1;
  }

  if (INVERT_STEERING) {
    error = -error;
  }

  // SHARP CORNER HANDLING

  if (error > 24) {
    filteredDerivative = 0;
    setMotors(turnSpeed, -turnSpeed);
    lastError = error;
    return;
  }

  if (error < -24) {
    filteredDerivative = 0;
    setMotors(-turnSpeed, turnSpeed);
    lastError = error;
    return;
  }

  // FILTERED DERIVATIVE

  float rawDerivative = error - lastError;

  filteredDerivative =
    0.70 * filteredDerivative +
    0.30 * rawDerivative;

  lastError = error;

  // ADAPTIVE SPEED CONTROL

  float errorMagnitude = abs(error);
  int currentSpeed;

  if (errorMagnitude <= 5) {
    currentSpeed = fastSpeed;
  }
  else if (errorMagnitude <= 15) {

    currentSpeed = fastSpeed -
      (int)((errorMagnitude - 5) *
      (fastSpeed - baseSpeed) / 10.0);
  }
  else {
    currentSpeed = baseSpeed;
  }

  // PD CORRECTION

  int correction =
    (int)(Kp * error +
          Kd * filteredDerivative);

  correction = constrain(correction, -110, 110);

  int leftMotor =
    currentSpeed + correction;

  int rightMotor =
    currentSpeed - correction;

  setMotors(leftMotor, rightMotor);
}

// =================================================
// SETUP
// =================================================

void setup() {

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(LED_BUILTIN, OUTPUT);

  stopMotors();

  setupSuction();
  startSuction();

  calibrateSensors();

  delay(1000);

  waitForPlacement();

  lastError = 0;
  filteredDerivative = 0;
  lastDirection = 1;
}

// =================================================
// MAIN LOOP
// =================================================

void loop() {
  followLine();
}
