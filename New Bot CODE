/* =========================================================================
   ATmega Architecture - Adaptive PD Line Follower with Suction Ramping
   Hardware: Arduino Nano, DRV8833, 8 Analog Sensors, Suction on D11 (PWM)
   ========================================================================= */

// --- 1. PINOUTS & HARDWARE DEFINITIONS ---
#define IN1 6   // Left Motor PWM A
#define IN2 5   // Left Motor PWM B
#define IN3 10  // Right Motor PWM A
#define IN4 9   // Right Motor PWM B

// Suction Impeller Control Pin (Moved to D11 for hardware PWM support)
#define SUCTION_PIN 11 

// Analog IR Sensor Pins (Left to Right: A7 down to A0)
const uint8_t sensorPins[8] = {A7, A6, A5, A4, A3, A2, A1, A0};

// Sensor Calibration Arrays
int minVal[8];
int maxVal[8];

// Sensor Weights (Centered around 0)
const int weights[8] = {-3500, -2500, -1500, -500, 500, 1500, 2500, 3500};

// --- 2. TUNING PARAMETERS ---
int baseSpeed = 90;           // Forward speed on straight tracks
int maxSpeed = 80;           // Maximum motor speed limit

// --- TURNING SENSITIVITY CONTROL ---
float turningSensitivity = 1.0; 

// PD Constants
float Kp = 0.06;              // Proportional gain
float Kd = 0.60;              // Derivative gain

// Suction Speed Ramping Variables
int suctionSpeed = 0;
bool rampingUp = true;

// State Variables
int lastError = 0;
int lastDirection = 1;        // 1 = Right, -1 = Left (used for line recovery)

void setup() {
  // Configure Motor and Suction Pins
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(SUCTION_PIN, OUTPUT);

  // Configure Sensor Pins
  for (uint8_t i = 0; i < 8; i++) {
    pinMode(sensorPins[i], INPUT);
  }

  Serial.begin(9600);

  // Startup Delay & Auto-Calibration Routine
  delay(1000);
  calibrateRobot();
}

void loop() {
  // --- GRADUAL SUCTION RAMP UP & DOWN LOGIC ---
  // Incrementally increases and decreases suction power inside the loop
  if (rampingUp) {
    suctionSpeed += 5; // Increase step size to speed up the ramping rate
    if (suctionSpeed >= 255) { // 255 is max PWM duty cycle (Full power)
      suctionSpeed = 255;
      rampingUp = false; // Switch direction to ramp down
    }
  } else {
    suctionSpeed -= 5;
    if (suctionSpeed <= 0) {
      suctionSpeed = 0;
      rampingUp = true;  // Switch direction back to ramp up
    }
  }
  analogWrite(SUCTION_PIN, suctionSpeed);

  // --- LINE FOLLOWER SENSOR READING & PD LOGIC ---
  long position = 0;
  long sum = 0;
  bool onLine = false;

  for (uint8_t i = 0; i < 8; i++) {
    int raw = analogRead(sensorPins[i]);
    long normalized = map(raw, minVal[i], maxVal[i], 0, 1000);
    normalized = constrain(normalized, 0, 1000);

    if (normalized > 200) {
      onLine = true;
    }

    sum += normalized;
    position += normalized * weights[i];
  }

  // --- LAST DIRECTION & LINE LOSS RECOVERY LOGIC ---
  if (!onLine || sum < 400) {
    if (lastDirection > 0) {
      setMotors(120, -120); // Spin right
    } else {
      setMotors(-120, 120); // Spin left
    }
    return;
  }

  int error = position / sum;

  if (error > 50) {
    lastDirection = 1;
  } else if (error < -50) {
    lastDirection = -1;
  }

  // --- ADAPTIVE PD ALGORITHM ---
  int derivative = error - lastError;
  int correction = (int)((Kp * error + Kd * derivative) * turningSensitivity);
  lastError = error;

  int leftSpeed = baseSpeed + correction;
  int rightSpeed = baseSpeed - correction;

  leftSpeed = constrain(leftSpeed, -20, maxSpeed);
  rightSpeed = constrain(rightSpeed, -20, maxSpeed);

  setMotors(leftSpeed, rightSpeed);
}

// --- 3. HELPER FUNCTIONS ---

void setMotors(int leftSpeed, int rightSpeed) {
  if (leftSpeed >= 0) {
    analogWrite(IN1, leftSpeed);
    analogWrite(IN2, 0);
  } else {
    analogWrite(IN1, 0);
    analogWrite(IN2, -leftSpeed);
  }

  if (rightSpeed >= 0) {
    analogWrite(IN3, rightSpeed);
    analogWrite(IN4, 0);
  } else {
    analogWrite(IN3, 0);
    analogWrite(IN4, -rightSpeed);
  }
}

void calibrateRobot() {
  for (uint8_t i = 0; i < 8; i++) {
    minVal[i] = 1023;
    maxVal[i] = 0;
  }

  unsigned long startTime = millis();
  
  while (millis() - startTime < 2000) {
    if ((millis() - startTime) < 1000) {
      setMotors(-80, 80);
    } else {
      setMotors(80, -80);
    }

    for (uint8_t i = 0; i < 8; i++) {
      int val = analogRead(sensorPins[i]);
      if (val < minVal[i]) minVal[i] = val;
      if (val > maxVal[i]) maxVal[i] = val;
    }
  }

  setMotors(0, 0);
  delay(500);
}
